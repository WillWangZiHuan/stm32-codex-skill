#include "{{MODULE_NAME}}.h"

extern TIM_HandleTypeDef {{TIM_HANDLE}};

void {{MODULE_NAME}}_init(void)
{
  (void){{MODULE_NAME}}_start();
}

void {{MODULE_NAME}}_process(void)
{
  /* Add one non-blocking application step here. */
}

HAL_StatusTypeDef {{MODULE_NAME}}_start(void)
{
  return HAL_TIM_PWM_Start(&{{TIM_HANDLE}}, {{TIM_CHANNEL}});
}

void {{MODULE_NAME}}_set_duty_permille(uint16_t duty_permille)
{
  uint32_t period = __HAL_TIM_GET_AUTORELOAD(&{{TIM_HANDLE}});
  uint32_t compare;

  if (duty_permille > 1000U) {
    duty_permille = 1000U;
  }
  compare = ((period + 1U) * duty_permille) / 1000U;
  __HAL_TIM_SET_COMPARE(&{{TIM_HANDLE}}, {{TIM_CHANNEL}}, compare);
}
