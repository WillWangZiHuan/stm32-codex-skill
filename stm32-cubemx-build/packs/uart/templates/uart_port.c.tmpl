HAL_StatusTypeDef {{MODULE_NAME}}_transmit(
    uint8_t *data,
    uint16_t length,
    uint32_t timeout_ms)
{
  if (length == 0U) {
    return HAL_OK;
  }
  if (data == NULL) {
    return HAL_ERROR;
  }
  return HAL_UART_Transmit(&{{UART_HANDLE}}, data, length, timeout_ms);
}

HAL_StatusTypeDef {{MODULE_NAME}}_receive(
    uint8_t *data,
    uint16_t length,
    uint32_t timeout_ms)
{
  if (length == 0U) {
    return HAL_OK;
  }
  if (data == NULL) {
    return HAL_ERROR;
  }
  return HAL_UART_Receive(&{{UART_HANDLE}}, data, length, timeout_ms);
}
